<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="mx.campana.ficha">
    <!-- La versión la inyecta scripts/build-apk.sh desde android/version.json.
         Ojo: si se declarase aquí, aapt2 ignoraría los parámetros de versión al
         enlazar y todas las builds saldrían con el mismo número, con lo que
         Android rechazaría cualquier actualización. -->

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- No pide ningún permiso: no usa red, ni cámara, ni ubicación.
         Las imágenes llegan por el selector del sistema, que no necesita permiso. -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hardwareAccelerated="true"
        android:supportsRtl="false">

        <!-- launchMode singleTop y no singleTask: con singleTask,
             startActivityForResult puede devolver cancelado al instante y el
             selector de imágenes no entregaría nunca nada. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
